Table systems.ref_settings AS ref_settings {
keys varchar [pk]
keyvalues text
keytypes varchar
keygroups varchar
keydescriptions varchar
last_updated timestamp
}

Table systems.ref_operating_hours As ref_operating_hours {
    id integer     [pk]
    branch_id integer
    day varchar
    open_time time
    close_time time
    is_closed boolean
}

Table systems.ref_holidays As ref_holidays { 
    id integer [pk]
    branch_id integer
    holiday_date date
    reason varchar
    is_closed boolean
}
Table objects.ref_banners AS ref_banners {
    id integer [pk]
    branch_id integer 
    title varchar
    image_url varchar
    link_url varchar
    display_order integer
    start_date date
    end_date date
    is_active boolean
}

Table ref_delivery_tracking { 
    id integer [pk]
    order_hk varchar [ref: > lnk_orders.order_hk, null] 
    latitude decimal(10,7)
    longitude decimal(10,7)
    recorded_at timestamp
}

Table systems.ref_activity_logs As ref_activity_logs { 
    id integer [pk]
    user_id integer
    action varchar
    entity_type varchar
    entity_id integer
    old_values json
    new_values json
    ip_address varchar
    user_agent varchar
    created_at timestamp
}

// Lineage

dep "setting" {
//settings.id -> 
settings.key -> ref_settings.keys
settings.value -> ref_settings.keyvalues
settings.type -> ref_settings.keytypes
settings.group -> ref_settings.keygroups
settings.description -> ref_settings.keydescriptions
settings.updated_at ->ref_settings.last_updated
}

dep "nonworking_days" {
//settings.id -> 
holidays.id -> ref_holidays.id
holidays.branch_id -> ref_holidays.branch_id
holidays.holiday_date -> ref_holidays.holiday_date
holidays.reason -> ref_holidays.reason
holidays.is_closed -> ref_holidays.is_closed
}

dep "operating_hours" {
//settings.id -> 
operating_hours.id -> ref_operating_hours.id
operating_hours.branch_id -> ref_operating_hours.branch_id
operating_hours.day -> ref_operating_hours.day
operating_hours.open_time -> ref_operating_hours.open_time
operating_hours.close_time -> ref_operating_hours.close_time
operating_hours.is_closed -> ref_operating_hours.is_closed
}

dep "activity_logs" {
activity_logs.id -> ref_activity_logs.id
activity_logs.user_id -> ref_activity_logs.user_id
activity_logs.action -> ref_activity_logs.action
activity_logs.entity_type -> ref_activity_logs.entity_type
activity_logs.entity_id -> ref_activity_logs.entity_id
activity_logs.old_values -> ref_activity_logs.old_values
activity_logs.new_values -> ref_activity_logs.new_values
activity_logs.ip_address -> ref_activity_logs.ip_address
activity_logs.user_agent -> ref_activity_logs.user_agent
activity_logs.created_at -> ref_activity_logs.created_at
}

dep "activity_logs" {
banners.id -> ref_banners.id
banners.branch_id -> ref_banners.branch_id
banners.title -> ref_banners.title
banners.image_url -> ref_banners.image_url
banners.link_url -> ref_banners.link_url
banners.display_order -> ref_banners.display_order
banners.start_date -> ref_banners.start_date
banners.end_date -> ref_banners.end_date
banners.is_active -> ref_banners.is_active
}









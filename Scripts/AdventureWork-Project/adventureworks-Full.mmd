Person["Person.Person"]:::person{
    int BusinessEntityID    PK  "NOT NULL"
	nchar   PersonType  "NOT NULL CHECK (PersonType IS NULL 
                        OR UPPER(PersonType) IN 
                        ('SC', 'VC', 'IN', 'EM', 'SP', 'GC'))"
    NameStyle   NameStyle   "NOT NULL DEFAULT (0)"
    nvarchar    Title   " NULL"
    Name    FirstName   "NOT NULL"
    Name    MiddleName
    Name    LastName    "NOT NULL"
    nvarchar    Suffix
    int EmailPromotion  "NOT NULL DEFAULT (0) CHECK 
                        (EmailPromotion BETWEEN 0 AND 2)"
    XML AdditionalContactInfo   "Person.AdditionalContactInfoSchemaCollection)"
    XML Demographics    "Person.IndividualSurveySchemaCollection"
    uniqueidentifier    rowguid "NOT NULL DEFAULT (NEWID())"
    datetime    ModifiedDate    "NOT NULL DEFAULT (GETDATE())"
}

PersonCreditCard["Person.PersonCreditCard"]:::person{

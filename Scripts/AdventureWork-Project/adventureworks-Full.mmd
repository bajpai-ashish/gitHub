    nvarchar    Shelf   " NOT NULL CHECK ((Shelf LIKE 'A-Za-z') OR (Shelf = 'N/A'))"
    tinyint Bin "NOT NULL CHECK (Bin BETWEEN 0 AND 100"
    smallint    Quantity    "NOT NULL DEFAULT (0)"
    uniqueidentifier    rowguid "NOT NULL DEFAULT (NEWID())"
    datetime    ModifiedDate    "NOT NULL DEFAULT (GETDATE())"
}

ProductListPriceHistory["Production.ProductListPriceHistory"]:::production{

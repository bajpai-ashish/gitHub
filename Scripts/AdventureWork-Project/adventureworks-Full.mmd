    money   SalesYTD    "NOT NULL DEFAULT (0.00) CHECK (SalesYTD >= 0.00)"
    money   SalesLastYear   "NOT NULL DEFAULT (0.00) CHECK (SalesLastYear >= 0.00)"
    uniqueidentifier    rowguid "NOT NULL DEFAULT (NEWID())"
    datetime    ModifiedDate    "NOT NULL DEFAULT (GETDATE())"
}


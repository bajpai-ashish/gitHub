Address ["Person.Address"]:::person{
    int    AddressID   PK   "IDENTITY NOT FOR REPLICATION NOT NULL"
    nvarchar   AddressLine1        "NOT NULL"
    nvarchar   AddressLine2      
    nvarchar   City        "NOT NULL"
    int    StateProvinceID     "NOT NULL"
    nvarchar   PostalCode      "NOT NULL"
    geography  SpatialLocation   
    uniqueidentifier   rowguid     "NOT NULL DEFAULT (NEWID())"
    datetime   ModifiedDate    "NOT NULL DEFAULT (GETDATE())"
}

AddressType["Person.AddressType"]:::person{
    int    AddressTypeID    PK       "IDENTITY NOT NULL"

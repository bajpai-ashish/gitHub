}

BillOfMaterials ["Production.BillOfMaterials"]:::production{
    int BillOfMaterialsID   PK  "IDENTITY (1, 1)"
    int ProductAssemblyID       "NULL CHECK (ProductAssemblyID <> ComponentID)"
    int ComponentID     "NOT NULL"
    datetime    StartDate       "NOT NULL DEFAULT (GETDATE())"
    datetime    EndDate     "CHECK ((EndDate > StartDate) OR (EndDate IS NULL))"
    nchar   UnitMeasureCode       "NOT NULL"
    smallint    BOMLevel        "NOT NULL CHECK (((ProductAssemblyID IS NULL) 
                                AND (BOMLevel = 0) AND (PerAssemblyQty = 1.00)) 
                                OR ((ProductAssemblyID IS NOT NULL) AND (BOMLevel >= 1)))"
    decimal PerAssemblyQty       "NOT NULL DEFAULT (1.00) CHECK (PerAssemblyQty >= 1.00)"
    datetime    ModifiedDate        "NOT NULL DEFAULT (GETDATE())"
}

Culture["Production.Culture"]:::production{
    nchar   CultureID   PK   "NOT NULL"
    Name    Name    "NOT NULL"
    datetime    ModifiedDate    "NOT NULL DEFAULT (GETDATE())"
}

Document["Production.Document"]:::production{
    hierarchyid DocumentNode    PK
	**computed**  DocumentLevel   "DocumentNode.GetLevel()"
    nvarchar    Title   "NOT NULL"
	int Owner   "NOT NULL"
	bit FolderFlag  "NOT NULL DEFAULT (0)"
    nvarchar    FileName    "NOT NULL"
    nvarchar    FileExtension   "NOT NULL"
    nchar   Revision    "NOT NULL"
    int ChangeNumber    "NOT NULL DEFAULT (0)"
    tinyint Status  "NOT NULL CHECK (Status BETWEEN 1 AND 3)"
    nvarchar    DocumentSummary
    varbinary   Document
    uniqueidentifier    rowguid "NEWID()"
    datetime    ModifiedDate    "NOT NULL DEFAULT (GETDATE())"
}

Illustration["Production.Illustration"]:::production{
    int IllustrationID  PK  "IDENTITY (1, 1)"
    XML Diagram "NULL"
    datetime    ModifiedDate    "NOT NULL DEFAULT (GETDATE())"

}

Location["Production.Location"]:::production{
    smallint    LocationID PK  "IDENTITY (1, 1)"
    Name    Name    "NOT NULL"
    smallmoney  CostRate    "NOT NULL DEFAULT (0.00)
                            CHECK (CostRate >= 0.00)"
    decimal Availability    "NOT NULL DEFAULT (0.00)
                            CHECK (Availability >= 0.00)"
    datetime    ModifiedDate    "NOT NULL DEFAULT (GETDATE())"
}

Product["Production.Product"]:::production{
    int ProductID   PK   "IDENTITY (1, 1)"
    Name    Name    "NOT NULL"
    nvarchar    ProductNumber   " NOT NULL"
    Flag    MakeFlag    "NOT NULL DEFAULT (1)"
    Flag    FinisheddsFlag  "NOT NULL DEFAULT (1)"
    nvarchar    Color   " NULL"
    smallint    SafetyStockLevel    "NOT NULL CHECK (SafetyStockLevel > 0)"
    smallint    ReorderPoint    "NOT NULL CHECK (ReorderPoint > 0)"
    money   StandardCost    "NOT NULL CHECK (StandardCost >= 0.00)"
    money   ListPrice   "NOT NULL CHECK (ListPrice >= 0.00)"
    nvarchar    Size    "  NULL"
    nchar   SizeUnitMeasureCode "  NULL"
    nchar   WeightUnitMeasureCode   "NULL"
    decimal Weight  " NULL CHECK (Weight > 0.00)"
    int DaysToManufacture   "NOT NULL CHECK (DaysToManufacture >= 0)"
    nchar   ProductLine "CHECK (UPPER(ProductLine) IN ('S', 'T', 'M', 'R') OR ProductLine IS NULL)"
    nchar   Class   "CHECK (UPPER(Class) IN ('L', 'M', 'H') OR Class IS NULL)"
    nchar   Style   "CHECK (UPPER(Style) IN ('W', 'M', 'U') OR Style IS NULL)"
    int ProductSubCategoryID   FK
    int ProductModelID  FK
    datetime    SellStartDate   "NOT NULL"
    datetime    SellEndDate "CHECK ((SellEndDate >= SellStartDate) OR (SellEndDate IS NULL))"
    datetime    DiscontinuedDate    "NULL"
    uniqueidentifier    rowguid "NOT NULL DEFAULT (NEWID())"
    datetime    ModifiedDate    "NOT NULL DEFAULT (GETDATE())"
}

ProductCatey["Production.ProductCategory"]:::production{
    int ProductCategoryID  PK  "IDENTITY (1, 1)"
    Name    Name    "NOT NULL"
    uniqueidentifier    rowguid "NOT NULL DEFAULT (NEWID())"
    datetime    ModifiedDate    "NOT NULL DEFAULT (GETDATE())"
}

ProductCostHistory["Production.ProductCostHistory"]:::production{
    int ProductID   PK   "Composite Key"
    datetime    StartDate   PK   "Composite Key"
    datetime    EndDate "CHECK ((EndDate >= StartDate)
                        OR (EndDate IS NULL))"
    money   StandardCost    "NOT NULL CHECK (StandardCost >= 0.00)"
    datetime    ModifiedDate    "NOT NULL DEFAULT (GETDATE())"
}

ProductDescription["Production.ProductDescription"]:::production{

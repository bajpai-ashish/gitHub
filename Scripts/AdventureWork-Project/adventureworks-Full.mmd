Customer["Sales.Customer"]:::sales{
	int    CustomerID  PK   "IDENTITY (1, 1) A customer may either be a person, a store, or a person who works for a store"
	int    PersonID    UK   "NULL If this customer represents a person, this is non-null"
    int    StoreID FK   "If the customer is a store, or is associated with a store then this is non-null."
    int    TerritoryID  FK
    **computed**   AccountNumber   "ISNULL('AW' + dbo.ufnLeadingZeros(CustomerID), '')"
    uniqueidentifier   rowguid "NOT NULL DEFAULT (NEWID())"
    datetime   ModifiedDate    "NOT NULL DEFAULT (GETDATE())"
}

SalesOrderDetail["Sales.SalesOrderDetail"]:::sales{
    int SalesOrderID    PK    "NOT NULL"
    int SalesOrderDetailID  PK  "IDENTITY (1, 1)"
    nvarchar    CarrierTrackingNumber
    smallint    OrderQty    "NOT NULL CHECK (OrderQty > 0)"
    int ProductID   "NOT NULL"
    int SpecialOfferID  "NOT NULL"
    money   UnitPrice   "NOT NULL CHECK (UnitPrice >= 0.00)"
    money   UnitPriceDiscount   "NOT NULL DEFAULT (0.0) CHECK (UnitPriceDiscount >= 0.00)"
    **computed**  LineTotal   "ISNULL(UnitPrice * (1.0 - UnitPriceDiscount) * OrderQty, 0.0)"
    uniqueidentifier    rowguid "NOT NULL DEFAULT (NEWID())"
    datetime    ModifiedDate    "NOT NULL DEFAULT (GETDATE())"
}

SalesOrderHeader["Sales.SalesOrderHeader"]:::sales{
    int SalesOrderID    PK    "IDENTITY (1, 1)"
    tinyint RevisionNumber  "NOT NULL DEFAULT (0)"
    datetime    OrderDate   "NOT NULL DEFAULT (GETDATE())"
    datetime    DueDate "NOT NULL CHECK (DueDate >= OrderDate)"
    datetime    ShipDate    "CHECK ((ShipDate >= OrderDate) OR (ShipDate IS NULL))"
    tinyint Status  "NOT NULL DEFAULT (1) CHECK (Status BETWEEN 0 AND 8)"
    Flag    OnlineOrderFlag "NOT NULL DEFAULT (1)"
    **computed**  SalesOrderNumber    "ISNULL(N'SO' + CONVERT(nvarchar(23), SalesOrderID), 
                                        N'*** ERROR ***')"
    OrderNumber PurchaseOrderNumber
    AccountNumber   AccountNumber
    int CustomerID  "NOT NULL"
    int SalesPersonID
    int TerritoryID
    int BillToAddressID "NOT NULL"
    int ShipToAddressID "NOT NULL"
    int ShipMethodID    "NOT NULL"
    int CreditCardID
    varchar CreditCardApprovalCode
    int CurrencyRateID
    money   SubTotal    "NOT NULL DEFAULT (0.00) CHECK (SubTotal >= 0.00)"
    money   TaxAmt  "NOT NULL DEFAULT (0.00) CHECK (TaxAmt >= 0.00)"
    money   Freight "NOT NULL DEFAULT (0.00) CHECK (Freight >= 0.00)"
    **computed**  TotalDue    "ISNULL(SubTotal + TaxAmt + Freight, 0)"
    nvarchar    Comment
    uniqueidentifier    rowguid "ROWGUIDCOL NOT NULL DEFAULT (NEWID())"
    datetime    ModifiedDate    "NOT NULL DEFAULT (GETDATE())"
}

SalesOrderHeaderSalesReason["Sales.SalesOrderHeaderSalesReason"]:::sales{
    int SalesOrderID    PK    "Composite Key"
    int SalesReasonID   PK   "Composite Key"
    datetime    ModifiedDate    "NOT NULL DEFAULT (GETDATE())"
}

